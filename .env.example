# Copy to .env and fill in. Values here are read by config.yaml through ${NAME}.

# Path of the configuration file (default: ./config.yaml)
LLM_GATEWAY_CONFIG=config.yaml

# Optional overrides
# LLM_GATEWAY_HOST=0.0.0.0
# LLM_GATEWAY_PORT=8080
# LLM_GATEWAY_LOG_LEVEL=info

# Upstream
OLLAMA_URL=http://localhost:11434

# API keys (generate with: openssl rand -hex 32)
GATEWAY_KEY_TEAM=
GATEWAY_KEY_CI=
