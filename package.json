{
  "name": "local-llm-gateway",
  "version": "0.0.0",
  "description": "OpenAI-compatible gateway for self-hosted models (Ollama, llama.cpp, vLLM): auth, model aliases, rate limits, metrics.",
  "license": "MIT",
  "author": "Mert Türkoğlu",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "smoke": "tsx scripts/smoke/run.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "prom-client": "15.1.3",
    "undici": "8.12.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "openai": "7.56.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
